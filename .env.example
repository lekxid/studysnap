# Docker Compose database configuration
POSTGRES_DB=studysnap
POSTGRES_USER=studysnap
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432

# Keep the password here identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg2://studysnap:replace_with_a_long_random_password@db:5432/studysnap

BACKEND_PORT=8000
