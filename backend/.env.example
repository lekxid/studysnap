APP_NAME=StudySnap AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./test.db

# Local default: uploads
# Azure Files mount example: /mnt/studysnap
STORAGE_ROOT=uploads

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Generate a unique value of at least 32 characters.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Comma-separated frontend origins. Never use * in beta or production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_APP_URL=http://localhost:3000

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback

# Private-beta registration control
INVITE_ONLY_SIGNUP=false
SIGNUP_INVITE_CODE=
